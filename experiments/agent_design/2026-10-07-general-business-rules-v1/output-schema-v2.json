{
  "$defs": {
    "BusinessClaimDraft": {
      "additionalProperties": false,
      "description": "A pointer to one populated field, not a duplicate editable statement.",
      "properties": {
        "field": {
          "enum": [
            "name",
            "description",
            "products_services",
            "customers",
            "monetization"
          ],
          "title": "Field",
          "type": "string"
        },
        "item_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Index"
        },
        "excerpts": {
          "items": {
            "$ref": "#/$defs/EvidenceExcerptDraft"
          },
          "minItems": 1,
          "title": "Excerpts",
          "type": "array"
        }
      },
      "required": [
        "field",
        "item_index",
        "excerpts"
      ],
      "title": "BusinessClaimDraft",
      "type": "object"
    },
    "BusinessDraftV2": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "company",
            "reportable_segment",
            "business",
            "offering_group"
          ],
          "title": "Kind",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "products_services": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Products Services",
          "type": "array"
        },
        "customers": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Customers",
          "type": "array"
        },
        "monetization": {
          "items": {
            "$ref": "#/$defs/MonetizationDraft"
          },
          "title": "Monetization",
          "type": "array"
        },
        "evidence_block_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Block Ids",
          "type": "array"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "market",
                "application_platform",
                "offering_group"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "claim_evidence": {
          "items": {
            "$ref": "#/$defs/BusinessClaimDraft"
          },
          "minItems": 1,
          "title": "Claim Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "evidence_block_ids",
        "claim_evidence"
      ],
      "title": "BusinessDraftV2",
      "type": "object"
    },
    "EvidenceExcerptDraft": {
      "additionalProperties": false,
