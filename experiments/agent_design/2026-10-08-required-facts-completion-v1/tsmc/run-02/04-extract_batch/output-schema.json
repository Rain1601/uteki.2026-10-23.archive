{
  "$defs": {
    "DraftEvidence": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "minLength": 1,
          "title": "Block Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "occurrence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occurrence Id"
        }
      },
      "required": [
        "block_id",
        "quote"
      ],
      "title": "DraftEvidence",
      "type": "object"
    },
    "DraftRecord": {
      "additionalProperties": false,
      "properties": {
        "draft_id": {
          "minLength": 1,
          "title": "Draft Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "financial",
            "guidance",
            "statement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "entity": {
          "minLength": 1,
          "title": "Entity",
          "type": "string"
        },
        "entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity Id"
        },
        "metric": {
          "minLength": 1,
          "title": "Metric",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "period_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Id"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "upper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "value_relation": {
          "enum": [
            "eq",
            "range",
            "approx",
            "gt",
            "gte",
            "qualitative",
            "unresolved"
          ],
          "title": "Value Relation",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "accounting_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accounting Basis"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "speaker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speaker"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/DraftEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "qualifiers": {
          "items": {
            "$ref": "#/$defs/DraftEvidence"
          },
          "title": "Qualifiers",
          "type": "array"
        },
        "question_refs": {
          "description": "Only source block IDs of analyst questions, when applicable. Never put task IDs, requirement IDs or record IDs here. Use [] for a financial statement without analyst questions.",
          "items": {
            "type": "string"
          },
          "title": "Question Refs",
          "type": "array"
        },
        "unresolved_fields": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Fields",
          "type": "array"
        }
      },
      "required": [
        "draft_id",
        "kind",
        "entity",
        "metric",
        "value_relation",
        "summary"
      ],
      "title": "DraftRecord",
      "type": "object"
    },
    "DraftRelation": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "minLength": 1,
          "title": "Relation Id",
          "type": "string"
        },
        "relation_type": {
          "minLength": 1,
          "title": "Relation Type",
          "type": "string"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Record Ids",
          "type": "array"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/DraftEvidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "relation_type",
        "record_ids",
        "description"
      ],
      "title": "DraftRelation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "records": {
      "items": {
        "$ref": "#/$defs/DraftRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/DraftRelation"
      },
      "title": "Relations",
      "type": "array"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    }
  },
  "title": "DirectExtraction",
  "type": "object"
}
