  "additionalProperties": false,
  "description": "Expose legal kind/role pairs in both JSON Schema and runtime validation.\n\nThese variants constrain structural classification, not source truth. A valid\npair still needs independent semantic review; never coerce a conflicting pair.",
  "properties": {
    "schema_version": {
      "const": "business-draft-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "company_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Company Id",
      "type": "string"
    },
    "document_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Document Id",
      "type": "string"
    },
    "period_end": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Period End",
      "type": "string"
    },
    "source_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Sha256",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Summary",
      "type": "string"
    },
    "relationship_absence": {
      "const": "unknown",
      "title": "Relationship Absence",
      "type": "string"
    },
    "businesses": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/CompanyNode"
          },
          {
            "$ref": "#/$defs/SegmentNode"
          },
          {
            "$ref": "#/$defs/BusinessNode"
          },
          {
            "$ref": "#/$defs/OfferingGroupNode"
          }
        ]
      },
      "minItems": 1,
      "title": "Businesses",
      "type": "array"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/RelationshipDraftV2"
      },
      "title": "Relationships",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "$ref": "#/$defs/UnknownDraft"
      },
      "title": "Unknowns",
      "type": "array"
    },
    "block_disposition": {
      "items": {
        "$ref": "#/$defs/BlockDispositionDraft"
      },
      "minItems": 1,
      "title": "Block Disposition",
      "type": "array"
    }
