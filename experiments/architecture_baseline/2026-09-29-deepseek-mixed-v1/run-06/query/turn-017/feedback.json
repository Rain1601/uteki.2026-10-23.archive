      },
      {
        "block_id": "block-000508-db0825c7",
        "ordinal": 508,
        "type": "list_item",
        "text": "•Changes to U.S. tax law enacted on July 4, 2025, allow, among other things, for immediate expensing of domestic research and experimentation costs and accelerated depreciation on eligible capital expenditures, the effects of which are included in operating cash flows for the year ended December 31, 2025.",
        "text_hash": "db0825c7ca7d0d92fb717fe6be5e39721a89d55d22c10b63c1b24236343da82b",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_94",
