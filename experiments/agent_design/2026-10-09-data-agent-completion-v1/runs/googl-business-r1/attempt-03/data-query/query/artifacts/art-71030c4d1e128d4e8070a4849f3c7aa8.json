        [
          "text-align",
          "justify"
        ],
        [
          "text-indent",
          "22.5pt"
        ]
      ],
      "table": null,
      "text": "Guided by our AI principles, we believe our approach to AI must be both bold and responsible. That means developing AI in a way that maximizes the positive benefits to society while addressing its potential challenges.",
      "text_hash": "bfd47c66180bf25e9bb8d8ef0a17fd1e0a670398963dc26d961e9430cd9e4a78",
      "type": "paragraph"
    },
    {
