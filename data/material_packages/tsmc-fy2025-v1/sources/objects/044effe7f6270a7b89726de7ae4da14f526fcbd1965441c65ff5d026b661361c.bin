e;white-space:pre;width:2.75pt"&gt;&lt;span style="background-color:inherit"&gt; &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="font-size:12pt;line-height:11pt;position:var(--position);text-align:justify;text-align-last:var(--justify);top:547.55pt;width:612pt"&gt;&lt;span style="background-color:#ffffff;font-family:'Times New Roman', serif;font-size:11pt;font-style:normal;font-weight:normal;left:107.46pt;position:var(--position);text-decoration:none;white-space:pre;width:214.64pt"&gt;&lt;span style="background-color:inherit"&gt;that the ratio for stock dividend shall not exceed &lt;/span&gt;&lt;/span&gt;&lt;span style="font-family:'Times New Roman', serif;font-size:11pt;font-style:normal;font-weight:normal;left:322.09999999999997pt;position:var(--position);text-decoration:none;white-space:pre;width:20.16pt"&gt;50%&lt;/span&gt;&lt;span style="background-color:#ffffff;font-family:'Times New Roman', serif;font-size:11pt;font-style:normal;font-weight:normal;left:342.26pt;position:var(--position);text-decoration:none;white-space:pre;width:106.56pt"&gt;&lt;span style="background-color:inherit"&gt; of the total distribution.&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color:#ffffff;font-family:'Times New Roman', serif;font-size:11pt;font-style:normal;font-weight:normal;left:448.82pt;position:var(--position);text-decoration:none;white-space:pre;width:2.75pt"&gt;&lt;span style="background-color:inherit"&gt; &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="font-size:12pt;line-height:11pt;position:var(--position);text-align:justify;text-align-last:var(--justify);top:572.75pt;width:612pt"&gt;&lt;span style="background-color:#ffffff;font-family:'Times New Roman', serif;font-size:11pt;font-style:normal;font-weight:normal;left:107.46pt;position:var(--position);text-decoration:none;white-space:pre;width:445.96pt"&gt;&lt;span style="background-color:inherit"&gt;The legal capital reserve may be used to offset a deficit, or be distributed as dividends in cash or&lt;/