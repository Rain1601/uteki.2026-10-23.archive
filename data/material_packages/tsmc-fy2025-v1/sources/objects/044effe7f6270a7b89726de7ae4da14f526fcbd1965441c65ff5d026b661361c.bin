;font-weight:normal;left:545.72pt;position:var(--position);text-decoration:none;white-space:pre;width:7.77pt"&gt;&lt;span style="background-color:inherit"&gt;to&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color:#ffffff;font-family:'Times New Roman', serif;font-size:10pt;font-style:normal;font-weight:normal;left:553.49pt;position:var(--position);text-decoration:none;white-space:pre;width:2.5pt"&gt;&lt;span style="background-color:inherit"&gt; &lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="font-size:12pt;line-height:10pt;position:var(--position);text-align:justify;text-align-last:var(--justify);top:483pt;width:612pt"&gt;&lt;span style="font-family:'Times New Roman', serif;font-size:10pt;font-style:normal;font-weight:normal;left:82.98pt;position:var(--position);text-decoration:none;white-space:pre;width:34.47pt"&gt;20 years&lt;/span&gt;&lt;span style="background-color:#ffffff;font-family:'Times New Roman', serif;font-size:10pt;font-style:normal;font-weight:normal;left:117.45pt;position:var(--position);text-decoration:none;white-space:pre;width:403.8pt"&gt;&lt;span style="background-color:inherit"&gt;; machinery and equipment (assets used by the Company and assets subject to operating leases) - &lt;/span&gt;&lt;/span&gt;&lt;span style="font-family:'Times New Roman', serif;font-size:10pt;font-style:normal;font-weight:normal;left:521.25pt;position:var(--position);text-decoration:none;white-space:pre;width:29.47pt"&gt;5 years&lt;/span&gt;&lt;span style="background-color:#ffffff;font-family:'Times New Roman', serif;font-size:10pt;font-style:normal;font-weight:normal;left:550.72pt;position:var(--position);text-decoration:none;white-space:pre;width:2.77pt"&gt;&lt;span style="background-color:inherit"&gt;;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color:#ffffff;font-family:'Times New Roman', serif;font-size:10pt;font-style:normal;font-weight:normal;left:553.49pt;position:var(--position);text-decoration:none;white-space:pre;width:2.5pt"&gt;&lt;span style