{
  "$defs": {
    "EvidenceExcerptDraft": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quote",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "quote"
      ],
      "title": "EvidenceExcerptDraft",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "enum": [
            "endpoint_scope",
            "omission",
            "claim_support",
            "attribute_semantics",
            "unknown_analysis"
          ],
          "title": "Category",
          "type": "string"
        },
        "target_keys": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Target Keys",
          "type": "array"
        },
        "excerpts": {
          "items": {
            "$ref": "#/$defs/EvidenceExcerptDraft"
          },
          "minItems": 1,
          "title": "Excerpts",
          "type": "array"
        },
        "node_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        },
        "explanation": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "category",
        "target_keys",
        "excerpts",
        "node_ids",
        "explanation"
      ],
      "title": "Issue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "business-semantic-critic-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "candidate_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Candidate Sha256",
      "type": "string"
    },
    "reviewed_check_keys": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "title": "Reviewed Check Keys",
      "type": "array"
    },
    "status": {
      "enum": [
        "pass",
        "needs_revision",
        "uncertain"
      ],
      "title": "Status",
      "type": "string"
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/Issue"
      },
      "title": "Issues",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "candidate_sha256",
    "reviewed_check_keys",
    "status",
    "issues"
  ],
  "title": "Review",
  "type": "object"
}
