        "table": null,
        "text": "Other Bets",
        "text_hash": "cf90ed0b1db4f96e794aa7e2437cc0f837dd38117d650bd6392c43966aeb267e",
        "type": "heading_candidate"
      },
      {
        "block_id": "block-000113-f5db1f8d",
        "dom_path": "/html/body/div[121]",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 113,
        "reported_page": 6,
