        "table": null,
        "text": "ITEM 5.MARKET FOR REGISTRANT’S COMMON EQUITY, RELATED STOCKHOLDER MATTERS, AND ISSUER PURCHASES OF EQUITY SECURITIES",
        "text_hash": "801a524b1c82e0d52dcdfc50f101a9518bae33018b0f333c97ff4bff92145062",
        "type": "heading_candidate"
      },
      {
        "block_id": "block-000359-c2624519",
        "dom_path": "/html/body/div[377]",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 359,
        "reported_page": 25,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_64",
        "style_signature": [
          [
            "font-family",
            "'arial',sans-serif"
