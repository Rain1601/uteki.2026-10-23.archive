{
  "$defs": {
    "BlockDispositionDraft": {
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Block Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "used",
            "context",
            "layout_noise",
            "not_used"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "block_id",
        "disposition",
        "reason"
      ],
      "title": "BlockDispositionDraft",
      "type": "object"
    },
    "BusinessClaimDraft": {
      "additionalProperties": false,
      "description": "A pointer to one populated field, not a duplicate editable statement.",
      "properties": {
        "field": {
          "enum": [
            "name",
            "description",
            "products_services",
            "customers",
            "monetization"
          ],
          "title": "Field",
          "type": "string"
        },
        "item_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Item Index"
        },
        "excerpts": {
          "items": {
            "$ref": "#/$defs/EvidenceExcerptDraft"
          },
          "minItems": 1,
          "title": "Excerpts",
          "type": "array"
        }
      },
      "required": [
        "field",
        "item_index",
        "excerpts"
      ],
      "title": "BusinessClaimDraft",
      "type": "object"
    },
