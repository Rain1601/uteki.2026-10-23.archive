{
  "name": "uteki-development-commands",
  "private": true,
  "scripts": {
    "progress": "python3 scripts/check_project_progress.py",
    "spec:list": "OPENSPEC_TELEMETRY=0 openspec list",
    "spec:show": "OPENSPEC_TELEMETRY=0 openspec show",
    "spec:status": "OPENSPEC_TELEMETRY=0 openspec status",
    "spec:check": "OPENSPEC_TELEMETRY=0 openspec validate --all --strict --no-interactive",
    "spec:new": "OPENSPEC_TELEMETRY=0 openspec new change",
    "spec:instructions": "OPENSPEC_TELEMETRY=0 openspec instructions",
    "spec:tasks": "OPENSPEC_TELEMETRY=0 openspec instructions apply"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.13.2"
  }
}
