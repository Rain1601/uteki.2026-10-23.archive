      ],
      "table": null,
      "text": "Privacy and Security",
      "text_hash": "c05a319b68060d02b74f81c2c337b6c5fe68cc8f9567327328d42770ccdb82cd",
      "type": "heading_candidate"
    },
    {
      "block_id": "block-000080-f0af3678",
      "dom_path": "/html/body/div[87]",
      "image_asset_id": null,
      "layout_role": null,
      "ordinal": 80,
      "reported_page": 4,
      "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_19",
      "style_signature": [
        [
          "font-family",
          "'arial',sans-serif"
        ],
        [
          "font-size",
          "10pt"
        ],
        [
          "font-weight",
          "400"
        ],
        [
          "line-height",
          "120%"
