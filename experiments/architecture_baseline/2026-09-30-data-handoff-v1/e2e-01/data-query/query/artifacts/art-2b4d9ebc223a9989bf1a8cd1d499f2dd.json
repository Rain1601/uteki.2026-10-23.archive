        ],
        "table": null,
        "image_asset_id": null,
        "layout_role": null
      },
      {
        "block_id": "block-000619-86c4d4b8",
        "ordinal": 619,
        "type": "paragraph",
        "text": "Leases",
        "text_hash": "86c4d4b8b288efab668d553d5a67be84d95a50872757ec24bc0527a38423cf87",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2116",
        "dom_path": "/html/body/div[668]",
        "reported_page": 38,
        "style_signature": [
          [
            "font-family",
            "'arial',sans-serif"
          ],
          [
            "font-size",
            "10pt"
          ],
          [
            "font-style",
            "italic"
          ],
          [
            "font-weight",
            "400"
          ],
          [
            "line-height",
            "120%"
