          ],
          [
            "font-size",
            "10pt"
          ]
        ],
        "table": null,
        "text": "•",
        "text_hash": "4f8865abeddbfab37520d0c56eed1bf17f37e3778e1a55e6dc54895d2ae17849",
        "type": "list_item"
      },
      {
        "block_id": "block-000097-13124fb7",
        "dom_path": "/html/body/div[15]/div[3]/div",
        "image_asset_id": null,
