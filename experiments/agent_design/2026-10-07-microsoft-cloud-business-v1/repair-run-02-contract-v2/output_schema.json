        "customers": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Customers",
          "type": "array"
        },
        "monetization": {
          "items": {
            "$ref": "#/$defs/MonetizationDraft"
          },
          "title": "Monetization",
          "type": "array"
        },
        "evidence_block_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Block Ids",
          "type": "array"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "market",
                "application_platform"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        },
        "claim_evidence": {
          "items": {
            "$ref": "#/$defs/BusinessClaimDraft"
          },
          "minItems": 1,
          "title": "Claim Evidence",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "description",
        "evidence_block_ids",
        "claim_evidence"
