  "blocks": [
    {
      "block_id": "block-001181-efcd150c",
      "dom_path": "/html/body/div[246]/div[2]/ix:nonnumeric/p[2]",
      "image_asset_id": null,
      "layout_role": null,
      "ordinal": 1181,
      "reported_page": 82,
      "source_anchor": "F_7f967ae4-814d-466a-a8e1-584a8795d9c6_2",
      "style_signature": [
