        [
          "font-size",
          "10pt"
        ]
      ],
      "table": null,
      "text": "•",
      "text_hash": "4f8865abeddbfab37520d0c56eed1bf17f37e3778e1a55e6dc54895d2ae17849",
      "type": "list_item"
    },
    {
      "block_id": "block-001187-7018adaa",
      "dom_path": "/html/body/div[246]/div[2]/ix:nonnumeric/div[1]/div",
      "image_asset_id": null,
      "layout_role": null,
      "ordinal": 1187,
      "reported_page": 82,
      "source_anchor": "F_7f967ae4-814d-466a-a8e1-584a8795d9c6_2",
