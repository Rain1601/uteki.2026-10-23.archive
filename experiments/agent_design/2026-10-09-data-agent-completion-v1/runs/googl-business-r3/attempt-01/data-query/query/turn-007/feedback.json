      {
        "block_id": "block-000070-2012752f",
        "dom_path": "/html/body/div[77]",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 70,
        "reported_page": 4,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_19",
