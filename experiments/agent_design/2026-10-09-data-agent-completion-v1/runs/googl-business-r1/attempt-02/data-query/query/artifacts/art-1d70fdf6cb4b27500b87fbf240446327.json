          "22.5pt"
        ]
      ],
      "table": null,
      "text": "We report our segment results as Google Services, Google Cloud, and Other Bets:",
      "text_hash": "46924ceb35d34f5e586923276997571501dd118f1c8c80a295821938d27b57f4",
      "type": "paragraph"
    },
    {
      "block_id": "block-001233-0b2226dd",
      "dom_path": "/html/body/ix:nonnumeric[6]/ix:continuation/div[2]",
      "image_asset_id": null,
      "layout_role": null,
      "ordinal": 1233,
      "reported_page": 86,
      "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_292",
      "style_signature": [
        [
          "font-family",
          "'arial',sans-serif"
        ],
        [
          "font-size",
          "10pt"
        ],
        [
          "font-weight",
          "400"
        ],
        [
          "line-height",
          "120%"
        ],
        [
          "margin-top",
          "6pt"
        ],
        [
          "padding-left",
          "36pt"
        ],
        [
          "text-align",
          "justify"
        ],
        [
          "text-indent",
          "-13.5pt"
        ]
      ],
      "table": null,
      "text": "•Google Services includes products and services such as ads, Android, Chrome, devices, Google Maps, Google Play, Search, and YouTube. Google Services generates revenues primarily from advertising; fees received for consumer subscription-based products such as YouTube TV, YouTube Music and Premium, and NFL Sunday Ticket, as well as Google One; the sale of apps and in-app purchases; and devices.",
      "text_hash": "0b2226dd5a7874ed45e01e909b84888e4c2ac295944d86fd8b6189716a5396df",
      "type": "list_item"
    },
    {
      "block_id": "block-001234-995bd5bd",
      "dom_path": "/html/body/ix:nonnumeric[6]/ix:continuation/div[3]",
      "image_asset_id": null,
      "layout_role": null,
      "ordinal": 1234,
      "reported_page": 86,
      "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_292",
      "style_signature": [
