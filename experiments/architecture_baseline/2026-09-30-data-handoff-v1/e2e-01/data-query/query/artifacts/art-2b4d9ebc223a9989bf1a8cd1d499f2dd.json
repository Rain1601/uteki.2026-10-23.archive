        "block_id": "block-000614-4e902c64",
        "ordinal": 614,
        "type": "paragraph",
        "text": "Our capital investments in property and equipment consist primarily of the following major categories:",
        "text_hash": "4e902c64635e1219b8a8c0f10311a8afdfbb6246f059fab86996fac45ce92569",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
