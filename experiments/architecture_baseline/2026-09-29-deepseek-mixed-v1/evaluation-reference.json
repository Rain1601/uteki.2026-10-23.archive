  "purpose_evidence": [
    {
      "finding_zh": "物业及设备购买和租赁安排共同支持产品与服务增长所需容量；租赁安排不能直接混入现金 PPE 指标。",
      "reference": {
        "source_snapshot_id": "googl-2025-10k",
        "index_id": "didx-d113d1d4ab51745c",
        "block_id": "block-000612-46f2125c",
        "text_hash": "46f2125cc43d2a5add52ac403b6ade6544c156b7e2650649fec5cc7c60975f39",
        "reported_page": 38,
        "dom_path": "/html/body/div[659]",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_157",
        "quote": "We make investments in land, buildings, and servers and network equipment through purchases of property and equipment and lease arrangements to provide capacity for the growth of our services and products.",
        "quote_start_codepoint": 0,
        "quote_end_codepoint": 205
      }
    },
    {
      "finding_zh": "技术基础设施包括服务器及网络设备、数据中心土地、建筑施工与改良。",
      "reference": {
        "source_snapshot_id": "googl-2025-10k",
        "index_id": "didx-d113d1d4ab51745c",
        "block_id": "block-000615-414413ff",
        "text_hash": "414413ff3b36fe13119a9baa8231d2b0ece780e1e429a8822860b54a306ffa77",
        "reported_page": 38,
        "dom_path": "/html/body/div[663]",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
        "quote": "•technical infrastructure, which consists of our investments in servers and network equipment, data center land, and building construction and improvements; and",
        "quote_start_codepoint": 0,
        "quote_end_codepoint": 160
      }
    },
    {
      "finding_zh": "另包括办公设施、从零开发项目和建筑改良。",
      "reference": {
        "source_snapshot_id": "googl-2025-10k",
        "index_id": "didx-d113d1d4ab51745c",
        "block_id": "block-000616-051391dc",
        "text_hash": "051391dc89b7e3d7115db44035ced8dc754c4d275dd4d16b70dcd96b2bd9430f",
        "reported_page": 38,
        "dom_path": "/html/body/div[664]",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
        "quote": "•office facilities, ground-up development projects, and building improvements.",
        "quote_start_codepoint": 0,
        "quote_end_codepoint": 78
      }
    },
    {
      "finding_zh": "资产购买到投入使用可能相隔数月至数年；现金支出不等于当期已投入使用资产或当期收益。",
      "reference": {
        "source_snapshot_id": "googl-2025-10k",
        "index_id": "didx-d113d1d4ab51745c",
        "block_id": "block-000617-b57c8ea3",
        "text_hash": "b57c8ea309d37559ddca34431a907c47a3e8005b0304358c83253530c3d7375e",
        "reported_page": 38,
        "dom_path": "/html/body/div[665]",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
        "quote": "Assets not yet in service are those that are not ready for their intended use, including assets in the process of construction or assembly, and consist primarily of technical infrastructure. The time frame from date of purchase to placement in service of these assets may extend from months to years. For example, our data center construction projects are generally multi-year projects with multiple phases, where we acquire land and buildings, construct buildings, and secure and install servers and network equipment.",
        "quote_start_codepoint": 0,
        "quote_end_codepoint": 519
      }
    },
    {
      "finding_zh": "MD&A 把现金资本开支概述为 2024 年 52.5 billion、2025 年 91.4 billion；这是舍入值，与现金流量表精确百万美元披露一致。折旧是在资产达到预定可使用状态后开始。",
      "reference": {
        "source_snapshot_id": "googl-2025-10k",
        "index_id": "didx-d113d1d4ab51745c",
        "block_id": "block-000618-45e1aa4d",
        "text_hash": "45e1aa4d064a378168a6be3b408423630eef25186c70c0b49e24d194913254d7",
        "reported_page": 38,
        "dom_path": "/html/body/div[666]",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
        "quote": "During the years ended December 31, 2024 and 2025, we spent $52.5 billion and $91.4 billion on capital expenditures, respectively. In 2026, we expect to significantly increase, relative to 2025, our investment in our technical infrastructure, including servers and network equipment, and data centers. Depreciation of our property and equipment commences when such assets are ready for their intended use. For the years ended December 31, 2024 and 2025, our depreciation on property and equipment was $15.3 billion and $21.1 billion, respectively.",
        "quote_start_codepoint": 0,
        "quote_end_codepoint": 547
      }
    }
  ],
  "interpretation_limits": [
    {
      "topic": "maintenance_capex",
      "assessment_zh": "这些披露不足以量化维持性与增长性资本开支；办公/技术类别是用途分类，不是维护/增长分类。折旧不能直接当作维持性资本开支。",
      "supporting_references": [
        {
          "source_snapshot_id": "googl-2025-10k",
          "index_id": "didx-d113d1d4ab51745c",
          "block_id": "block-000615-414413ff",
          "text_hash": "414413ff3b36fe13119a9baa8231d2b0ece780e1e429a8822860b54a306ffa77",
          "reported_page": 38,
          "dom_path": "/html/body/div[663]",
          "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
          "quote": "•technical infrastructure, which consists of our investments in servers and network equipment, data center land, and building construction and improvements; and",
          "quote_start_codepoint": 0,
          "quote_end_codepoint": 160
        },
        {
          "source_snapshot_id": "googl-2025-10k",
          "index_id": "didx-d113d1d4ab51745c",
          "block_id": "block-000616-051391dc",
          "text_hash": "051391dc89b7e3d7115db44035ced8dc754c4d275dd4d16b70dcd96b2bd9430f",
          "reported_page": 38,
          "dom_path": "/html/body/div[664]",
          "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
          "quote": "•office facilities, ground-up development projects, and building improvements.",
          "quote_start_codepoint": 0,
          "quote_end_codepoint": 78
        },
        {
          "source_snapshot_id": "googl-2025-10k",
          "index_id": "didx-d113d1d4ab51745c",
          "block_id": "block-000617-b57c8ea3",
          "text_hash": "b57c8ea309d37559ddca34431a907c47a3e8005b0304358c83253530c3d7375e",
          "reported_page": 38,
          "dom_path": "/html/body/div[665]",
          "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
          "quote": "Assets not yet in service are those that are not ready for their intended use, including assets in the process of construction or assembly, and consist primarily of technical infrastructure. The time frame from date of purchase to placement in service of these assets may extend from months to years. For example, our data center construction projects are generally multi-year projects with multiple phases, where we acquire land and buildings, construct buildings, and secure and install servers and network equipment.",
          "quote_start_codepoint": 0,
          "quote_end_codepoint": 519
        },
        {
          "source_snapshot_id": "googl-2025-10k",
          "index_id": "didx-d113d1d4ab51745c",
          "block_id": "block-000618-45e1aa4d",
          "text_hash": "45e1aa4d064a378168a6be3b408423630eef25186c70c0b49e24d194913254d7",
          "reported_page": 38,
          "dom_path": "/html/body/div[666]",
          "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
          "quote": "During the years ended December 31, 2024 and 2025, we spent $52.5 billion and $91.4 billion on capital expenditures, respectively. In 2026, we expect to significantly increase, relative to 2025, our investment in our technical infrastructure, including servers and network equipment, and data centers. Depreciation of our property and equipment commences when such assets are ready for their intended use. For the years ended December 31, 2024 and 2025, our depreciation on property and equipment was $15.3 billion and $21.1 billion, respectively.",
          "quote_start_codepoint": 0,
          "quote_end_codepoint": 547
        }
      ],
      "missing_information": [
        "separately attributed maintenance cash spending",
        "replacement versus incremental capacity split"
      ]
    },
    {
      "topic": "ai_roi",
      "assessment_zh": "这些披露不足以计算 AI ROI：缺少 AI 专属投资额、增量回报、归因及期限；不能从总资本开支和 OCF 同步变化推导因果回报。",
      "supporting_references": [
        {
          "source_snapshot_id": "googl-2025-10k",
          "index_id": "didx-d113d1d4ab51745c",
          "block_id": "block-000072-8371f0be",
          "text_hash": "8371f0be8b31f9fb79c01de33a080d5633ac7e7012ba58492daa0baaf088dd58",
          "reported_page": 4,
          "dom_path": "/html/body/div[79]",
          "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_19",
          "quote": "At the foundation of our full-stack approach is our AI-optimized infrastructure — a key differentiator enabling us to power our own products, such as Search and YouTube, and support the services we provide to our Google Cloud customers. Our technical infrastructure allows us to use and offer our customers a range of AI accelerator options, including specialized Graphics Processing Units (GPUs) and our own custom-built Tensor Processing Units (TPUs), such as Ironwood, our seventh-generation TPU. We are focused on driving efficiencies in our data centers, allowing us to leverage our technical infrastructure to deliver our products and services at an increasing scale while simultaneously enabling world-class research and model development.",
          "quote_start_codepoint": 0,
          "quote_end_codepoint": 746
        },
        {
          "source_snapshot_id": "googl-2025-10k",
          "index_id": "didx-d113d1d4ab51745c",
          "block_id": "block-000161-8380754a",
          "text_hash": "8380754af157057db9f1c3d3fbfd2d8995fdab73dbbc4211a459aafb366173dc",
          "reported_page": 9,
          "dom_path": "/html/body/div[175]",
          "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_43",
          "quote": "We have invested and expect to expand our investment in new businesses, products, services, and technologies in a wide range of industries beyond online advertising. The investments that we are making across our businesses — such as building AI-optimized infrastructure, including our custom TPUs, and integrating AI capabilities into new and existing products and services — reflect our ongoing efforts to innovate and provide products and services that are helpful to users, advertisers, publishers, customers, content providers, and distribution partners. Our investments ultimately may not be commercially viable or may not result in an adequate return of capital and, in pursuing new strategies, we may incur unanticipated liabilities.",
          "quote_start_codepoint": 0,
          "quote_end_codepoint": 740
        },
        {
          "source_snapshot_id": "googl-2025-10k",
          "index_id": "didx-d113d1d4ab51745c",
          "block_id": "block-000401-1e11d4d5",
          "text_hash": "1e11d4d5bae66cd558702f8152cbc5e8291a68b8044e8ba8d1ed4687769915a4",
          "reported_page": 28,
          "dom_path": "/html/body/div[425]",
          "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_79",
          "quote": "Expanded AI Offerings in our Products and Services: The continuing evolution of the online world has contributed to the growth of our business. We expect that this evolution, including user engagement with AI products and services, will continue to benefit our business and our revenues. As we continue to incorporate AI into our products and services, such as with AI Overviews and AI Mode in Search, and with enterprise AI solutions on our Google Cloud Platform, we may monetize differently than our historical consumer and enterprise offerings which could affect revenue growth rates and margin trends. When developing new products and services we generally focus first on user experience and then on monetization. At the same time, we face increasing competition, including from other developers and providers of AI products and services, which may affect our revenues.",
          "quote_start_codepoint": 0,
          "quote_end_codepoint": 873
        }
      ],
      "missing_information": [
        "AI-specific invested capital",
        "attributable incremental net cash returns",
        "investment/benefit timing and counterfactual"
      ]
    },
