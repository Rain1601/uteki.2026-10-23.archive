            "minLength": 1,
            "title": "Fact Id",
            "type": "string"
          },
          "verdict": {
            "enum": [
              "supported",
              "contradicted",
              "insufficient_evidence"
            ],
            "title": "Verdict",
            "type": "string"
          },
          "rationale": {
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Rationale",
            "type": "string"
          },
          "citations": {
            "default": [],
            "items": {
              "$ref": "#/$defs/SourceQuote"
            },
            "maxItems": 16,
            "title": "Citations",
            "type": "array"
          }
        },
        "required": [
          "fact_id",
          "verdict",
          "rationale"
        ],
        "title": "FactCheck",
        "type": "object"
      },
      "RequirementCheck": {
