          "margin-top",
          "6pt"
        ],
        [
          "padding-left",
          "36pt"
        ],
        [
          "text-align",
          "justify"
        ],
        [
          "text-indent",
          "-13.5pt"
        ]
      ],
      "table": null,
      "text": "•Google Cloud includes infrastructure and platform services, applications, and other services for enterprise customers. Google Cloud generates revenues primarily from consumption-based fees and subscriptions received for Google Cloud Platform services, Google Workspace communication and collaboration tools, and other enterprise services.",
      "text_hash": "995bd5bd22090a91774c8470ffa27f07c87a34ad97c0b92068824c2d0ac24d53",
      "type": "list_item"
