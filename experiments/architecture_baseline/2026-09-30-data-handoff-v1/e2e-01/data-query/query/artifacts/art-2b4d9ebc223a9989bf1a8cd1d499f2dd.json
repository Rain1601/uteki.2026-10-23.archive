        "layout_role": null
      },
      {
        "block_id": "block-000616-051391dc",
        "ordinal": 616,
        "type": "list_item",
        "text": "•office facilities, ground-up development projects, and building improvements.",
        "text_hash": "051391dc89b7e3d7115db44035ced8dc754c4d275dd4d16b70dcd96b2bd9430f",
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_2121",
        "dom_path": "/html/body/div[664]",
        "reported_page": 38,
        "style_signature": [
          [
            "font-family",
            "'arial',sans-serif"
          ],
          [
            "font-size",
            "10pt"
