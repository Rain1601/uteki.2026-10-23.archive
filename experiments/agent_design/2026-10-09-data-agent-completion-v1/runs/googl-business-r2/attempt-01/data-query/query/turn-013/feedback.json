    "items": [
      {
        "block_id": "block-000085-7bd7f443",
        "dom_path": "/html/body/div[92]",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 85,
        "reported_page": 4,
        "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_19",
