        "description": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Description",
          "type": "string"
        },
        "evidence_block_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Evidence Block Ids",
          "type": "array"
        },
        "basis": {
          "enum": [
            "explicit",
            "derived",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "rationale": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        },
        "excerpts": {
          "items": {
            "$ref": "#/$defs/EvidenceExcerptDraft"
          },
          "title": "Excerpts",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "target_id",
        "kind",
        "description",
        "evidence_block_ids",
        "basis",
        "rationale",
        "excerpts"
      ],
      "title": "RelationshipDraftV2",
      "type": "object"
    },
