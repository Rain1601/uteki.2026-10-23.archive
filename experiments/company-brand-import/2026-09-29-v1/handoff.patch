+        result.pop("retryAfterSeconds", None)
+        return result, data
+    except IdentityReviewRequired as exc:
+        result.update(status="needs_review", error=str(exc))
+    except (BrandImportError, OSError) as exc:
+        result["error"] = str(exc)
+    return result, None
