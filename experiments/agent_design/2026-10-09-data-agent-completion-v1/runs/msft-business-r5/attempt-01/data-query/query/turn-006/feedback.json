            "font-size",
            "10pt"
          ]
        ],
        "table": null,
        "text": "•",
        "text_hash": "4f8865abeddbfab37520d0c56eed1bf17f37e3778e1a55e6dc54895d2ae17849",
        "type": "list_item"
      },
      {
        "block_id": "block-000095-61bd513b",
        "dom_path": "/html/body/div[15]/div[2]/div",
        "image_asset_id": null,
        "layout_role": null,
        "ordinal": 95,
        "reported_page": 5,
        "source_anchor": "F_52de2956-2cf6-4683-90c8-0b4adeb07187",
        "style_signature": [
          [
            "font-family",
            "arial"
          ],
          [
            "font-size",
            "10pt"
          ]
        ],
        "table": null,
        "text": "Microsoft 365 Consumer products and cloud services, including Microsoft 365 Consumer subscriptions, Office licensed on-premises, and other consumer services.",
        "text_hash": "61bd513b7ff69104bce0b7c1e0bdb29e8d8f9ada2b9b0d1368f2554de078f784",
        "type": "paragraph"
      },
