        ],
        "table": null,
        "text": "PART I",
        "text_hash": "495768bd3d6957619d4fbe2457811a0483df9e815938bdd9fb195935ece1b264",
        "type": "heading_candidate"
      },
      {
        "block_id": "block-000139-c5ddfeff",
        "dom_path": "/html/body/div[23]/p[2]",
        "image_asset_id": null,
        "layout_role": "running_header",
        "ordinal": 139,
        "reported_page": 8,
        "source_anchor": "F_52de2956-2cf6-4683-90c8-0b4adeb07187",
