      ],
      "table": null,
      "text": "Privacy and Security",
      "text_hash": "c05a319b68060d02b74f81c2c337b6c5fe68cc8f9567327328d42770ccdb82cd",
      "type": "heading_candidate"
    },
    {
      "block_id": "block-000080-f0af3678",
      "dom_path": "/html/body/div[87]",
      "image_asset_id": null,
      "layout_role": null,
      "ordinal": 80,
      "reported_page": 4,
      "source_anchor": "i6be430fe3ebf411481dcec8b0abe9149_19",
      "style_signature": [
        [
          "font-family",
          "'arial',sans-serif"
        ],
        [
          "font-size",
          "10pt"
        ],
        [
          "font-weight",
          "400"
        ],
        [
          "line-height",
          "120%"
        ],
        [
          "margin-top",
          "6pt"
        ],
        [
          "text-align",
          "justify"
        ],
        [
          "text-indent",
          "22.5pt"
        ]
      ],
      "table": null,
      "text": "We make it a priority to protect the privacy and security of our products, users, and customers, even if there are near-term financial consequences. We do this by continuously investing in building products that are secure by default; strictly upholding responsible data practices that emphasize privacy by design; and building easy-to-use settings that put people in control. We are continually enhancing these efforts over time, whether by enabling users to auto-delete their data, applying privacy technologies like on-device processing, giving people tools to control their experience, or advancing anti-malware, anti-phishing, and password security features.",
      "text_hash": "f0af36788acad032126553327b96c4a7381292f6b82fe4993401921345d6068f",
      "type": "paragraph"
    },
